# ============================================================================
# SHIFT HAPPENS! by HYDRAFORGE — Environment Variables Template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# Primary connection string used by the backend. Postgres with pgvector enabled.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Server ------------------------------------------------------------------
# Port the Express API + SPA server listens on (default 4000).
PORT=4000
# JWT signing secret (used when BETTER_AUTH_SECRET is absent). Generate:
#   openssl rand -base64 32
JWT_SECRET=generate_with_openssl_rand_base64_32
# Alternatively, the Better Auth secret used for JWT/refresh tokens.
BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_32
# Seed admin credentials (used by `npm run seed`).
ADMIN_EMAIL=admin@shifthappens.test
ADMIN_PASSWORD=change-me-now

# --- AI (LLM) ----------------------------------------------------------------
# Used by ShiftBot, the AI phone agent, and review analysis. Any OpenAI-compatible
# provider works — the default is OpenRouter (gpt-4o-mini).
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# --- Payments (Stripe) -------------------------------------------------------
# https://dashboard.stripe.com/apikeys — use a test key in development.
STRIPE_SECRET_KEY=sk_test_xxxx
# Webhook signing secret from Stripe (https://dashboard.stripe.com/webhooks).
# Points at POST /api/v1/stripe/webhook. Cards via the POS require this.
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# Default currency for Stripe PaymentIntents.
STRIPE_CURRENCY=usd

# --- Twilio (AI phone agent + SMS) -------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
# Phone number the AI agent can transfer a live caller to.
STAFF_TRANSFER_NUMBER=+15551234567

# --- SendGrid (email confirmations) ------------------------------------------
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google (calendar sync, maps, reviews) -----------------------------------
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# --- DocuSign (event contracts) ----------------------------------------------
DOCUSIGN_ACCESS_TOKEN=your_docusign_access_token

# --- Reviews / Sentiment -----------------------------------------------------
YELP_API_KEY=your_yelp_fusion_api_key

# --- AI phone agent runtime (optional) ---------------------------------------
# Which restaurant the voice agent books for when none is linked to the caller.
VOICE_RESTAURANT_ID=
# Local timezone offset applied to spoken time slots (hours).
VOICE_TIMEZONE_OFFSET_HOURS=0
