# ============================================================================
# SHIFT HAPPENS! by HYDRAFORGE — Environment Variables Template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- AI (Gemini) -------------------------------------------------------------
# Used by the ShiftBot assistant and AI upsell. The value is inlined into the
# client bundle by Vite during `define`, so use a restricted/scrubbed key here.
# Production should proxy AI calls through the backend (see /server) instead.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Database (PostgreSQL) ---------------------------------------------------
# Primary connection string used by the backend/ORM.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# PostgREST endpoint (Neon/Supabase-style REST layer), if used.
NEON_API_URL=https://your-host.apirest.region.aws.neon.tech/neondb/rest/v1

# --- Auth (Better Auth) ------------------------------------------------------
# Generate a strong secret, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# --- Payments (Stripe) -------------------------------------------------------
# https://dashboard.stripe.com/apikeys — use a test key in development.
STRIPE_SECRET_KEY=sk_test_xxxx

# --- Integrations (needed for full feature set, see build prompt) ------------
# Twilio (AI Phone Agent + SMS notifications)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WEBHOOK_URL=/api/twilio/voice

# SendGrid (Email confirmations / marketing)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Calendar OAuth (reservation sync)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Outlook Calendar OAuth (reservation sync)
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret
OUTLOOK_REDIRECT_URI=http://localhost:3000/oauth/outlook/callback

# DocuSign (event contracts)
DOCUSIGN_INTEGRATION_KEY=your_docusign_integration_key

# Reviews / Sentiment
GOOGLE_PLACES_API_KEY=your_google_places_api_key
YELP_API_KEY=your_yelp_fusion_api_key

# Local knowledge for AI agent
SERPAPI_KEY=your_serpapi_key

# --- Frontend runtime (optional) ----------------------------------------------
# Public URL of the deployed app (used by PWA + CORS).
VITE_PUBLIC_URL=http://localhost:3000
